# Copy this file to .env and fill in the values.
# Docker Compose and the API both read from .env in the repo root.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Connection string (used by apps/api)
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
PORT=3000
# Set to your frontend's origin. In production: CORS_ORIGIN=https://your-frontend.com
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Web (frontend)
# -----------------------------------------------------------------------------
# Full URL of the API server — used by the browser to make direct requests.
VITE_API_URL=http://localhost:3000