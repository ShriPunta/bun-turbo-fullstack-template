# Copy this file to .env and fill in the values.
# Docker Compose and the API both read from .env in the repo root.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Connection string (used by apps/api)
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
PORT=3000
# Comma-separated allowed origins. Trailing slashes are stripped automatically.
# Example: CORS_ORIGIN=https://app.example.com,https://staging.example.com
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Web (frontend)
# -----------------------------------------------------------------------------
# Full URL of the API server — used by the browser to make direct requests.
# No default: must be set explicitly for both local dev and production builds.
VITE_API_URL=http://localhost:3000