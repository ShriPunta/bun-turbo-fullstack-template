{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"enabled": true,
		"rules": { "recommended": true }
	},
	"organizeImports": { "enabled": true },
	"files": {
		"ignore": [
			"**/dist/**",
			"**/node_modules/**",
			"**/routeTree.gen.ts",
			"**/drizzle/**",
			".turbo/**"
		]
	}
}
