{
	"name": "@pkg/schema",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"lint": "biome check src",
		"type-check": "tsc --noEmit",
		"db:generate": "bun run --env-file ../../.env drizzle-kit generate",
		"db:migrate": "bun run --env-file ../../.env src/migrate.ts",
		"db:seed": "bun run --env-file ../../.env src/seed.ts"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.5",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/bun": "^1.2.0",
		"drizzle-kit": "^0.31.10",
		"typescript": "^5.8.3"
	}
}
